<Window x:Class="CourseTasksList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задачник"
        Height="600" Width="800"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Показывать элемент только в режиме редактирования строки -->
        <Style x:Key="VisibleWhenEditing" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Показывать элемент только когда строка не редактируется -->
        <Style x:Key="VisibleWhenNotEditing" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <TextBlock Grid.Row="0"
                   Text="Задачник"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,16"/>

        <!-- Таблица задач -->
        <DockPanel Grid.Row="1">

            <!-- Шапка таблицы: остаётся на месте при прокрутке -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="#C8C8C8"
                    BorderThickness="0,0,0,2"
                    Padding="6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Задача" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Дата добавления" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="Срок сдачи" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="Статус задачи" FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- Прокручиваемый список задач -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="16"/>
                                        <ColumnDefinition Width="0.5*"/>
                                        <ColumnDefinition Width="0.75*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Задача -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Title}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource VisibleWhenNotEditing}"/>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="2,1"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource VisibleWhenEditing}"/>

                                    <!-- Дата добавления -->
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding CreatedAt, StringFormat=dd.MM.yyyy}"
                                               VerticalAlignment="Center"/>

                                    <!-- Срок сдачи -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding Deadline, StringFormat=dd.MM.yyyy, TargetNullValue=—}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource VisibleWhenNotEditing}"/>
                                    <TextBox Grid.Column="3"
                                             Text="{Binding DeadlineText, UpdateSourceTrigger=LostFocus}"
                                             Padding="2,1"
                                             VerticalAlignment="Center"
                                             Style="{StaticResource VisibleWhenEditing}"/>

                                    <!-- Статус -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding StatusTitle}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource VisibleWhenNotEditing}"/>
                                    <ComboBox Grid.Column="4"
                                              ItemsSource="{Binding DataContext.StatusOptions,
                                                            RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                              DisplayMemberPath="Title"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Status, Mode=TwoWay}"
                                              IsEnabled="{Binding IsExisting}"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource VisibleWhenEditing}"/>

                                    <!-- Кнопки строки -->
                                    <StackPanel Grid.Column="5"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                        <Button Content="Д"
                                                Width="24" Height="24" Padding="0" Margin="0,0,4,0"
                                                ToolTip="Добавить задачу в планировщик"
                                                Command="{Binding DataContext.CommitTaskCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VisibleWhenEditing}"/>
                                        <Button Content="Р"
                                                Width="24" Height="24" Padding="0" Margin="0,0,4,0"
                                                ToolTip="Редактировать задачу"
                                                Command="{Binding DataContext.EditTaskCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource VisibleWhenNotEditing}"/>
                                        <Button Content="✕"
                                                Width="24" Height="24" Padding="0"
                                                ToolTip="Удалить задачу"
                                                Command="{Binding DataContext.DeleteTaskCommand,
                                                          RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </DockPanel>

        <!-- Кнопки внизу -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <Button Content="Добавить задачу"
                    MinWidth="150"
                    Padding="16,5"
                    Margin="0,0,10,0"
                    Command="{Binding AddTaskCommand}"/>
            <Button Content="Сохранить и выйти"
                    MinWidth="150"
                    Padding="16,5"
                    Command="{Binding SaveAndExitCommand}"/>
        </StackPanel>
    </Grid>
</Window>
