<Window x:Class="CourseTasksList.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Задачник"
        Height="600" Width="800"
        MinHeight="420" MinWidth="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->
        <TextBlock Grid.Row="0"
                   Text="Задачник"
                   FontSize="28"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,16"/>

        <!-- Таблица задач -->
        <DockPanel Grid.Row="1">

            <!-- Шапка таблицы: остаётся на месте при прокрутке -->
            <Border DockPanel.Dock="Top"
                    BorderBrush="#C8C8C8"
                    BorderThickness="0,0,0,2"
                    Padding="6,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.5*"/>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="60"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Задача" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="Дата добавления" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="Срок сдачи" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="Статус задачи" FontWeight="Bold"/>
                </Grid>
            </Border>

            <!-- Прокручиваемая область со строками задач -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="TasksPanel"/>
            </ScrollViewer>

        </DockPanel>

        <!-- Кнопки внизу (пока без функционала) -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,0">
            <Button Content="Добавить задачу"
                    MinWidth="150"
                    Padding="16,5"
                    Margin="0,0,10,0"/>
            <Button Content="Сохранить и выйти"
                    MinWidth="150"
                    Padding="16,5"/>
        </StackPanel>
    </Grid>
</Window>
